<Window x:Class="MiniDoc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniDoc" Width="980" Height="720" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="New_Click" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="Open_Click" />
                <Separator />
                <MenuItem x:Name="SaveMenuItem" Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click" />
                <MenuItem x:Name="SaveAsMenuItem" Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}" />
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}" />
                <Separator />
                <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" CommandTarget="{Binding ElementName=Editor}" />
                <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=Editor}" />
                <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=Editor}" />
                <MenuItem Header="Select _All" Command="ApplicationCommands.SelectAll" CommandTarget="{Binding ElementName=Editor}" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar x:Name="FormattingToolbar">
                <Button Width="30" FontWeight="Bold" Content="B" ToolTip="Bold" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}" />
                <Button Width="30" FontStyle="Italic" Content="I" ToolTip="Italic" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}" />
                <Button Width="30" Content="U" ToolTip="Underline" TextBlock.TextDecorations="Underline" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}" />
                <Separator />
                <ComboBox x:Name="FontFamilyBox" Width="150" ToolTip="Font family" SelectionChanged="FontFamilyBox_SelectionChanged">
                    <ComboBoxItem Content="Segoe UI" />
                    <ComboBoxItem Content="Arial" />
                    <ComboBoxItem Content="Calibri" />
                    <ComboBoxItem Content="Times New Roman" />
                    <ComboBoxItem Content="Courier New" />
                </ComboBox>
                <ComboBox x:Name="FontSizeBox" Width="72" ToolTip="Font size" SelectionChanged="FontSizeBox_SelectionChanged">
                    <ComboBoxItem Content="9" /><ComboBoxItem Content="10" /><ComboBoxItem Content="11" />
                    <ComboBoxItem Content="12" /><ComboBoxItem Content="14" /><ComboBoxItem Content="16" />
                    <ComboBoxItem Content="18" /><ComboBoxItem Content="24" /><ComboBoxItem Content="32" />
                </ComboBox>
                <ComboBox x:Name="ColorBox" Width="95" ToolTip="Text color" SelectionChanged="ColorBox_SelectionChanged">
                    <ComboBoxItem Content="Black" Tag="#000000" />
                    <ComboBoxItem Content="Blue" Tag="#0057B8" />
                    <ComboBoxItem Content="Dark red" Tag="#8B0000" />
                    <ComboBoxItem Content="Dark green" Tag="#006400" />
                    <ComboBoxItem Content="Gray" Tag="#666666" />
                </ComboBox>
                <Separator />
                <Button Width="36" Content="L" ToolTip="Align left" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Editor}" />
                <Button Width="36" Content="C" ToolTip="Center" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Editor}" />
                <Button Width="36" Content="R" ToolTip="Align right" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Editor}" />
                <Button Width="36" Content="J" ToolTip="Justify" Command="EditingCommands.AlignJustify" CommandTarget="{Binding ElementName=Editor}" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready" /></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="NoticeBorder" Grid.Row="0" Background="#FFF7D6" BorderBrush="#E4C65E" BorderThickness="0,0,0,1" Padding="10,7" Visibility="Collapsed">
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" />
            </Border>

            <RichTextBox x:Name="Editor" Grid.Row="1" Padding="48,36" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         AcceptsTab="True" SpellCheck.IsEnabled="False"
                         TextChanged="Editor_TextChanged"
                         CommandManager.PreviewExecuted="Editor_PreviewExecuted" />

            <Grid x:Name="PdfHost" Grid.Row="1" Visibility="Collapsed" Background="#EFEFEF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" BorderBrush="#D8D8D8" BorderThickness="0,0,0,1" Padding="8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PrevButton" Content="Previous" Padding="12,4" Margin="2" Click="PrevPdf_Click" />
                        <TextBlock x:Name="PdfPageText" MinWidth="95" TextAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                        <Button x:Name="NextButton" Content="Next" Padding="12,4" Margin="2" Click="NextPdf_Click" />
                        <Separator Margin="10,0" />
                        <Button Content="−" Width="30" Margin="2" Click="ZoomOut_Click" />
                        <TextBlock x:Name="PdfZoomText" MinWidth="55" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="+" Width="30" Margin="2" Click="ZoomIn_Click" />
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20">
                    <Border Background="White" BorderBrush="#C8C8C8" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Image x:Name="PdfImage" Stretch="None" />
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
