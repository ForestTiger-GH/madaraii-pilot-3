<ribbon:RibbonWindow x:Class="MiniDoc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        Title="MiniDoc" Width="1120" Height="780" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ribbon:Ribbon x:Name="MainRibbon" Grid.Row="0" Title="MiniDoc">
            <ribbon:Ribbon.QuickAccessToolBar>
                <ribbon:RibbonQuickAccessToolBar>
                    <ribbon:RibbonButton x:Name="QuickSaveButton" Label="Save" ToolTip="Save (Ctrl+S)" Click="Save_Click" />
                    <ribbon:RibbonButton Label="Undo" ToolTip="Undo" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}" />
                    <ribbon:RibbonButton Label="Redo" ToolTip="Redo" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}" />
                </ribbon:RibbonQuickAccessToolBar>
            </ribbon:Ribbon.QuickAccessToolBar>

            <ribbon:Ribbon.ApplicationMenu>
                <ribbon:RibbonApplicationMenu>
                    <ribbon:RibbonApplicationMenuItem Header="New" Click="New_Click" />
                    <ribbon:RibbonApplicationMenuItem Header="Open..." Click="Open_Click" />
                    <ribbon:RibbonApplicationMenuItem x:Name="SaveMenuItem" Header="Save" Click="Save_Click" />
                    <ribbon:RibbonApplicationMenuItem x:Name="SaveAsMenuItem" Header="Save As..." Click="SaveAs_Click" />
                    <ribbon:RibbonApplicationMenuItem Header="Exit" Click="Exit_Click" />
                </ribbon:RibbonApplicationMenu>
            </ribbon:Ribbon.ApplicationMenu>

            <ribbon:RibbonTab Header="Home">
                <ribbon:RibbonGroup Header="Clipboard">
                    <ribbon:RibbonButton Label="Cut" Command="ApplicationCommands.Cut" CommandTarget="{Binding ElementName=Editor}" />
                    <ribbon:RibbonButton Label="Copy" Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=Editor}" />
                    <ribbon:RibbonButton Label="Paste" Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=Editor}" />
                    <ribbon:RibbonButton Label="Select All" Command="ApplicationCommands.SelectAll" CommandTarget="{Binding ElementName=Editor}" />
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup x:Name="FontGroup" Header="Font">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <ComboBox x:Name="FontFamilyBox" Width="138" Margin="1" SelectionChanged="FontFamilyBox_SelectionChanged">
                            <ComboBoxItem Content="Segoe UI" />
                            <ComboBoxItem Content="Arial" />
                            <ComboBoxItem Content="Aptos" />
                            <ComboBoxItem Content="Calibri" />
                            <ComboBoxItem Content="Times New Roman" />
                            <ComboBoxItem Content="Courier New" />
                        </ComboBox>
                        <ComboBox x:Name="FontSizeBox" Width="58" Margin="1" SelectionChanged="FontSizeBox_SelectionChanged">
                            <ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/>
                            <ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/>
                            <ComboBoxItem Content="24"/><ComboBoxItem Content="32"/><ComboBoxItem Content="48"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <ribbon:RibbonToggleButton Label="Bold" FontWeight="Bold" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}" />
                        <ribbon:RibbonToggleButton Label="Italic" FontStyle="Italic" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}" />
                        <ribbon:RibbonToggleButton Label="Underline" TextBlock.TextDecorations="Underline" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="Color" VerticalAlignment="Center" Margin="2,0" />
                        <ComboBox x:Name="ColorBox" Width="92" Margin="1" SelectionChanged="ColorBox_SelectionChanged">
                            <ComboBoxItem Content="Black" Tag="#000000" />
                            <ComboBoxItem Content="Blue" Tag="#0057B8" />
                            <ComboBoxItem Content="Dark red" Tag="#8B0000" />
                            <ComboBoxItem Content="Dark green" Tag="#006400" />
                            <ComboBoxItem Content="Gray" Tag="#666666" />
                        </ComboBox>
                        <TextBlock Text="Highlight" VerticalAlignment="Center" Margin="6,0,2,0" />
                        <ComboBox x:Name="HighlightBox" Width="82" Margin="1" SelectionChanged="HighlightBox_SelectionChanged">
                            <ComboBoxItem Content="Yellow" Tag="#FFFF00" />
                            <ComboBoxItem Content="Green" Tag="#00FF00" />
                            <ComboBoxItem Content="Cyan" Tag="#00FFFF" />
                            <ComboBoxItem Content="Pink" Tag="#FF00FF" />
                            <ComboBoxItem Content="Blue" Tag="#0000FF" />
                            <ComboBoxItem Content="Red" Tag="#FF0000" />
                            <ComboBoxItem Content="None" Tag="Transparent" />
                        </ComboBox>
                    </StackPanel>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup x:Name="ParagraphGroup" Header="Paragraph">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <ribbon:RibbonButton Label="Left" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Editor}" />
                        <ribbon:RibbonButton Label="Center" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Editor}" />
                        <ribbon:RibbonButton Label="Right" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Editor}" />
                        <ribbon:RibbonButton Label="Justify" Command="EditingCommands.AlignJustify" CommandTarget="{Binding ElementName=Editor}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <ribbon:RibbonButton Label="Indent −" Click="IndentDecrease_Click" />
                        <ribbon:RibbonButton Label="Indent +" Click="IndentIncrease_Click" />
                        <ribbon:RibbonButton Label="Space −" Click="SpaceDecrease_Click" />
                        <ribbon:RibbonButton Label="Space +" Click="SpaceIncrease_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="Fill" VerticalAlignment="Center" Margin="2,0" />
                        <ComboBox x:Name="ParagraphFillBox" Width="92" Margin="1" SelectionChanged="ParagraphFillBox_SelectionChanged">
                            <ComboBoxItem Content="None" Tag="Transparent" />
                            <ComboBoxItem Content="Light yellow" Tag="#FFF2CC" />
                            <ComboBoxItem Content="Light blue" Tag="#DDEBF7" />
                            <ComboBoxItem Content="Light green" Tag="#E2F0D9" />
                            <ComboBoxItem Content="Light gray" Tag="#E7E6E6" />
                        </ComboBox>
                    </StackPanel>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="Editing">
                    <StackPanel Margin="3" Width="230">
                        <DockPanel Margin="0,1">
                            <TextBlock Text="Find" Width="52" VerticalAlignment="Center" />
                            <TextBox x:Name="FindBox" MinWidth="150" KeyDown="FindBox_KeyDown" />
                        </DockPanel>
                        <DockPanel Margin="0,1">
                            <TextBlock Text="Replace" Width="52" VerticalAlignment="Center" />
                            <TextBox x:Name="ReplaceBox" MinWidth="150" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="Find next" Padding="8,2" Margin="1" Click="FindNext_Click" />
                            <Button Content="Replace" Padding="8,2" Margin="1" Click="Replace_Click" />
                            <Button Content="All" Padding="8,2" Margin="1" Click="ReplaceAll_Click" />
                        </StackPanel>
                    </StackPanel>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <ribbon:RibbonTab Header="Insert">
                <ribbon:RibbonGroup x:Name="TableInsertGroup" Header="Table">
                    <ribbon:RibbonButton Label="Insert 3×3" Click="InsertTable_Click" />
                    <ribbon:RibbonButton x:Name="TableAddRowButton" Label="Add row" Click="AddTableRow_Click" />
                    <ribbon:RibbonButton x:Name="TableDeleteRowButton" Label="Delete row" Click="DeleteTableRow_Click" />
                    <ribbon:RibbonButton x:Name="TableAddColumnButton" Label="Add column" Click="AddTableColumn_Click" />
                    <ribbon:RibbonButton x:Name="TableDeleteColumnButton" Label="Delete column" Click="DeleteTableColumn_Click" />
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="Cell fill" VerticalAlignment="Center" Margin="2,0" />
                        <ComboBox x:Name="CellFillBox" Width="92" Margin="1" SelectionChanged="CellFillBox_SelectionChanged">
                            <ComboBoxItem Content="None" Tag="Transparent" />
                            <ComboBoxItem Content="Light yellow" Tag="#FFF2CC" />
                            <ComboBoxItem Content="Light blue" Tag="#DDEBF7" />
                            <ComboBoxItem Content="Light green" Tag="#E2F0D9" />
                            <ComboBoxItem Content="Light gray" Tag="#E7E6E6" />
                        </ComboBox>
                    </StackPanel>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <ribbon:RibbonTab Header="View">
                <ribbon:RibbonGroup Header="PDF">
                    <ribbon:RibbonButton x:Name="RibbonPrevButton" Label="Previous page" Click="PrevPdf_Click" />
                    <ribbon:RibbonButton x:Name="RibbonNextButton" Label="Next page" Click="NextPdf_Click" />
                    <ribbon:RibbonButton x:Name="RibbonZoomOutButton" Label="Zoom out" Click="ZoomOut_Click" />
                    <ribbon:RibbonButton x:Name="RibbonZoomInButton" Label="Zoom in" Click="ZoomIn_Click" />
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>
        </ribbon:Ribbon>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="NoticeBorder" Grid.Row="0" Background="#FFF7D6" BorderBrush="#E4C65E" BorderThickness="0,0,0,1" Padding="10,7" Visibility="Collapsed">
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="1" Background="#EDEDED" Padding="24">
                <RichTextBox x:Name="Editor" Background="White" Padding="52,42" BorderBrush="#C8C8C8" BorderThickness="1"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             AcceptsTab="True" SpellCheck.IsEnabled="False"
                             TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged"
                             CommandManager.PreviewExecuted="Editor_PreviewExecuted" />
            </Border>

            <Grid x:Name="PdfHost" Grid.Row="1" Visibility="Collapsed" Background="#EFEFEF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" BorderBrush="#D8D8D8" BorderThickness="0,0,0,1" Padding="8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PrevButton" Content="Previous" Padding="12,4" Margin="2" Click="PrevPdf_Click" />
                        <TextBlock x:Name="PdfPageText" MinWidth="95" TextAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                        <Button x:Name="NextButton" Content="Next" Padding="12,4" Margin="2" Click="NextPdf_Click" />
                        <Separator Margin="10,0" />
                        <Button Content="−" Width="30" Margin="2" Click="ZoomOut_Click" />
                        <TextBlock x:Name="PdfZoomText" MinWidth="55" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="+" Width="30" Margin="2" Click="ZoomIn_Click" />
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20">
                    <Border Background="White" BorderBrush="#C8C8C8" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Image x:Name="PdfImage" Stretch="None" />
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready" /></StatusBarItem>
        </StatusBar>
    </Grid>
</ribbon:RibbonWindow>
